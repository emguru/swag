# OpenAI (optional — mock/heuristic used if unset)
OPENAI_API_KEY=

# --- Deployment profile ---
# Local default: FAISS + sentence-transformers + heuristic SWAG ($0)
# Cloud: set VECTOR_STORE_BACKEND=qdrant, EMBEDDING_PROVIDER=openai, add OPENAI_API_KEY
# On-prem LLM: LLM_PROVIDER=ollama, OLLAMA_BASE_URL=http://host.docker.internal:11434

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434

VECTOR_STORE_BACKEND=faiss
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=swag_chunks

DATA_DIR=./data
INDEXES_DIR=./indexes

CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=10
RETRIEVAL_CANDIDATES=20

VECTOR_WEIGHT=0.65
SWAG_WEIGHT=0.30
METADATA_WEIGHT=0.05

SWAG_ENABLED=true
SWAG_INGEST_PROFILES=true
SWAG_PROFILE_MODE=heuristic
SWAG_GRADER_MODEL=gpt-4o-mini
SWAG_MIN_SCORE_THRESHOLD=0.08
SWAG_NOISE_RELATIVE_VECTOR_RATIO=0.65
SWAG_MAX_CHUNKS_PER_SOURCE=3

API_HOST=0.0.0.0
API_PORT=8080
