# OpenAI API key (optional — MockLLM used if unset)
OPENAI_API_KEY=

# Embedding provider: sentence-transformers | openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM provider: openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Vector store backend: faiss | chroma | qdrant
VECTOR_STORE_BACKEND=faiss

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
TOP_K=10
RETRIEVAL_CANDIDATES=20

# Scoring weights (must sum to 1.0)
VECTOR_WEIGHT=0.65
SWAG_WEIGHT=0.30
METADATA_WEIGHT=0.05
